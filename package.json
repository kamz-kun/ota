{
  "name": "hot-updater-custom-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "start:container": "bun src/container.ts",
    "typecheck": "tsc --noEmit",
    "db:schema": "hot-updater db generate src/hotUpdater.ts src/db --yes",
    "db:generate": "bun run db:schema && bunx --bun drizzle-kit generate",
    "db:migrate": "bun src/migrate.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@hot-updater/aws": "^0.35.7",
    "@hot-updater/server": "^0.35.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "hot-updater": "^0.35.7",
    "typescript": "^7.0.2"
  }
}
